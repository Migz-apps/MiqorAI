PORT=3000
NODE_ENV=production
# IANA zone that defines "today" for day-boundary queries and reports.
PLATFORM_TIMEZONE=Africa/Kigali
# Forced exit if graceful shutdown has not finished after this many ms.
SHUTDOWN_TIMEOUT_MS=10000
# Proxy hops in front of the API (Render router / ingress): keeps req.ip the client IP.
TRUST_PROXY=1
# Seeding is refused when NODE_ENV=production unless FORCE_SEED=1 (never set this on a live database).
# FORCE_SEED=

DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
SUPABASE_STORAGE_BUCKET=miqorai-uploads

JWT_SECRET=<generate-strong-secret>
JWT_REFRESH_SECRET=<generate-strong-secret>
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

ENCRYPTION_KEY=<32-byte-encryption-key>
FILE_SIGNING_SECRET=<strong-file-signing-secret>
QR_SECRET=<strong-qr-secret>
# Patient QR validity in seconds (QR_REFRESH_SECONDS is the legacy name; do not set both).
QR_TTL_SECONDS=300

SMTP_HOST=<smtp-host>
SMTP_PORT=587
# true for implicit TLS (port 465 implies it); false for STARTTLS on 587.
SMTP_SECURE=false
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-password>
SMTP_FROM=noreply@miqorai.com

SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=<twilio-account-sid>
TWILIO_AUTH_TOKEN=<twilio-auth-token>
SMS_FROM_NUMBER=<twilio-phone-number>

CORS_ORIGINS=https://patient.miqorai.com,https://hospital.miqorai.com,https://insurance.miqorai.com,https://pharmacy.miqorai.com,https://admin.miqorai.com
UPLOAD_DIR=./uploads
INVITATION_EXPIRY_DAYS=7
# Rate limits: authenticated requests per user, unauthenticated per client IP
# (RATE_LIMIT_PER_MINUTE is the legacy name of the per-IP limit).
RATE_LIMIT_PER_USER_PER_MINUTE=300
RATE_LIMIT_PER_IP_PER_MINUTE=600
AUDIT_ARCHIVE_DAYS=365
OTP_EXPIRES_MINUTES=10
PASSWORD_RESET_EXPIRES_MINUTES=60
AUTH_CHALLENGE_RESEND_COOLDOWN_SECONDS=45
AUTH_CHALLENGE_MAX_ATTEMPTS=5
BASE_URL=https://miqorai.onrender.com

# Public portal URLs used in invitation / password-reset email links. Set all
# five explicitly: when unset they are guessed from CORS_ORIGINS and finally
# fall back to BASE_URL (the API host), which breaks the links.
PATIENT_PORTAL_URL=https://patient.miqorai.com
HOSPITAL_PORTAL_URL=https://hospital.miqorai.com
INSURANCE_PORTAL_URL=https://insurance.miqorai.com
PHARMACY_PORTAL_URL=https://pharmacy.miqorai.com
ADMIN_PORTAL_URL=https://admin.miqorai.com

# Background loops (domain-event outbox + report schedules). true = run inside
# the API process (single-service deploy). false = a dedicated worker process
# (npm run start:worker) runs them; required whenever a worker is deployed or the
# API has more than one instance (render.yaml and deploy/k8s use false).
WORKER_INLINE=false

# Clinical-safety AI service. AI_SERVICE_BASE_URL is the one to set;
# AI_SERVICE_URL is a legacy alias that is ignored whenever AI_SERVICE_BASE_URL is set.
AI_SERVICE_BASE_URL=https://mazimpakamiguel-miqorai.hf.space
# Shared secret; must equal AI_SERVICE_API_KEY configured on the AI service.
AI_SERVICE_API_KEY=<strong-shared-ai-service-key>
AI_SERVICE_TIMEOUT_SECONDS=60
AI_SERVICE_ENABLED=true
MIQORAI_AI_MOCK=false
# true = block prescriptions / lab orders (pending doctor action) when the
# clinical-safety service is disabled or unreachable, instead of proceeding unchecked.
CLINICAL_SAFETY_REQUIRED=true

# Single-mailbox mode: deliver ALL outgoing email to this one address
# (intended recipient is kept in the subject/body). Leave empty to deliver normally.
EMAIL_REDIRECT_ALL_TO=

# SEEDING ONLY - read by `npm run db:seed` (prisma/seed.ts), never by the running
# API. Seeding WIPES the database DATABASE_URL points at: never run it against
# production. Leave unset here.
# SEED_PASSWORD=
