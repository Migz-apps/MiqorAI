PORT=3000
NODE_ENV=production

DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
SUPABASE_STORAGE_BUCKET=miqorai-uploads

JWT_SECRET=<generate-strong-secret>
JWT_REFRESH_SECRET=<generate-strong-secret>
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

ENCRYPTION_KEY=<32-byte-encryption-key>
FILE_SIGNING_SECRET=<strong-file-signing-secret>
QR_SECRET=<strong-qr-secret>
QR_REFRESH_SECONDS=60

SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-password>
SMTP_FROM=noreply@miqorai.com

SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=<twilio-account-sid>
TWILIO_AUTH_TOKEN=<twilio-auth-token>
SMS_FROM_NUMBER=<twilio-phone-number>

CORS_ORIGINS=https://patient.miqorai.com,https://hospital.miqorai.com,https://insurance.miqorai.com,https://pharmacy.miqorai.com,https://admin.miqorai.com
UPLOAD_DIR=./uploads
INVITATION_EXPIRY_DAYS=7
RATE_LIMIT_PER_MINUTE=100
AUDIT_ARCHIVE_DAYS=365
OTP_EXPIRES_MINUTES=10
BASE_URL=https://api.miqorai.com

AI_SERVICE_BASE_URL=https://mazimpakamiguel-miqorai.hf.space
AI_SERVICE_URL=https://mazimpakamiguel-miqorai.hf.space
AI_SERVICE_API_KEY=
AI_SERVICE_TIMEOUT_SECONDS=60
AI_SERVICE_ENABLED=true
MIQORAI_AI_MOCK=false

# Single-mailbox mode: deliver ALL outgoing email to this one address
# (intended recipient is kept in the subject/body). Leave empty to deliver normally.
EMAIL_REDIRECT_ALL_TO=
