#
# MiqorAI production environment template.
# Replace every placeholder before deploying.
#
PORT=3000
NODE_ENV=production

# Supabase pooled Postgres connection
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres
REDIS_URL=rediss://default:YOUR_UPSTASH_PASSWORD@YOUR_UPSTASH_HOST.upstash.io:6379

# Optional but recommended for uploads and exports in deployed environments.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_STORAGE_BUCKET=miqorai-uploads

JWT_SECRET=generate-a-random-string-at-least-32-chars
JWT_REFRESH_SECRET=generate-another-random-string-at-least-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

ENCRYPTION_KEY=generate-a-32-byte-encryption-key!!
FILE_SIGNING_SECRET=generate-a-file-signing-secret!!

QR_SECRET=generate-a-qr-secret-key
QR_REFRESH_SECONDS=60

SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxxxxxxx
SMTP_FROM=noreply@miqorai.com

SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMS_FROM_NUMBER=

CORS_ORIGINS=https://patient.example.com,https://hospital.example.com,https://insurance.example.com,https://pharmacy.example.com,https://admin.example.com
UPLOAD_DIR=./uploads
INVITATION_EXPIRY_DAYS=7
RATE_LIMIT_PER_MINUTE=100
AUDIT_ARCHIVE_DAYS=365
OTP_EXPIRES_MINUTES=10
PASSWORD_RESET_EXPIRES_MINUTES=60
AUTH_CHALLENGE_RESEND_COOLDOWN_SECONDS=45
AUTH_CHALLENGE_MAX_ATTEMPTS=5
BASE_URL=https://miqorai.onrender.com
PATIENT_PORTAL_URL=https://patient.example.com
HOSPITAL_PORTAL_URL=https://hospital.example.com
INSURANCE_PORTAL_URL=https://insurance.example.com
PHARMACY_PORTAL_URL=https://pharmacy.example.com
ADMIN_PORTAL_URL=https://admin.example.com

# Always-on clinical safety AI service
AI_SERVICE_BASE_URL=https://your-ai-service.example.com
AI_SERVICE_URL=https://your-ai-service.example.com
AI_SERVICE_API_KEY=
AI_SERVICE_TIMEOUT_SECONDS=60
AI_SERVICE_ENABLED=true
MIQORAI_AI_MOCK=false
