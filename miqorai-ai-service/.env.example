# MiqorAI clinical-safety AI service settings (app/config.py).
# Every value below is the code default. Copy to .env for local runs; on the
# Hugging Face Space set them as Space variables/secrets; in Kubernetes they come
# from the miqorai-config ConfigMap and miqorai-secrets Secret.
# Names are case-insensitive (pydantic-settings).

# Display name returned by GET /
APP_NAME=MiqorAI Clinical Safety Service
# Bind address/port (the container CMD passes --host/--port to uvicorn explicitly)
HOST=0.0.0.0
PORT=8000

# Base model pulled from the Hugging Face Hub at start-up (needs outbound HTTPS to huggingface.co)
BASE_MODEL_ID=Qwen/Qwen1.5-0.5B-Chat
# LoRA adapter directory, relative to the working directory (/app in the image)
ADAPTER_PATH=model/miqorai-qwen1.5-0.5b-lora-json-v3
# 4-bit loading; only applied when CUDA is available and bitsandbytes is installed (GPU=1 build)
USE_4BIT=true
TRUST_REMOTE_CODE=true

# Generation parameters (keep aligned with training)
MAX_NEW_TOKENS=160
REPETITION_PENALTY=1.2
NO_REPEAT_NGRAM_SIZE=4

# Include the raw model output in every response (debugging only; never in production)
DEBUG_RAW_MODEL_OUTPUT=false

# Comma-separated browser origins allowed cross-origin. Empty disables CORS: the
# backend calls this service server-to-server and needs no CORS.
CORS_ORIGINS=

# SECRET. When set, inference endpoints require "Authorization: Bearer <key>".
# Must equal AI_SERVICE_API_KEY on the API server. Empty leaves the service open (dev only).
AI_SERVICE_API_KEY=
